{
  "BaseComponent": {
    "TypeName": "DecoratorPluginDemo.Plugins.TextProcessorComponent, DecoratorPluginDemo",
    "Name": "自定义示例处理器",
    "Parameters": {
      "name": "基础处理器"
    }
  },
  "Decorators": [
    {
      "TypeName": "DecoratorPluginDemo.Examples.PrefixSuffixDecorator, DecoratorPluginDemo",
      "Name": "前缀后缀装饰器",
      "Enabled": true,
      "Priority": 10,
      "Parameters": {
        "name": "括号包装器",
        "prefix": "《",
        "suffix": "》"
      }
    },
    {
      "TypeName": "DecoratorPluginDemo.Examples.ReplaceDecorator, DecoratorPluginDemo",
      "Name": "替换装饰器",
      "Enabled": true,
      "Priority": 20,
      "Parameters": {
        "name": "空格替换器",
        "oldValue": " ",
        "newValue": "-"
      }
    },
    {
      "TypeName": "DecoratorPluginDemo.Decorators.UpperCaseDecorator, DecoratorPluginDemo",
      "Name": "大写转换装饰器",
      "Enabled": true,
      "Priority": 30,
      "Parameters": {
        "name": "大写转换"
      }
    }
  ]
}
